---
import { Heading } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import {
  experience as defaultExperience,
  education as defaultEducation,
  skills as defaultSkills,
  leadership as defaultLeadership,
  type ExperienceEntry,
  type EducationEntry,
  type SkillCategory,
  type LeadershipEntry,
} from '@utils/resumeData'

/**
 * Resume Component
 *
 * @description A component that displays a summary of work experience, education, skills,
 * and leadership involvement
 */
interface Props {
  /**
   * Additional classes to apply to the section
   */
  class?: string
  /**
   * The title for the section
   * @default "Experience"
   */
  title?: string
  /**
   * Work experience entries, most recent first
   */
  experience?: ExperienceEntry[]
  /**
   * Education entries, most recent first
   */
  education?: EducationEntry[]
  /**
   * Skill categories
   */
  skills?: SkillCategory[]
  /**
   * Leadership and involvement entries
   */
  leadership?: LeadershipEntry[]
}

const {
  class: className,
  title = 'Experience',
  experience = defaultExperience,
  education = defaultEducation,
  skills = defaultSkills,
  leadership = defaultLeadership,
}: Props = Astro.props
---

<section id="experience" class:list={[className, 'my-64']}>
  <div class="container">
    <Heading level="h2" class="mb-8">{title}</Heading>
    <div>
      <div class="mb-6 flex items-center gap-3">
        <Icon aria-hidden="true" name="lucide:briefcase" size="1.75rem" />
        <Heading level="h3" size="h4">Work</Heading>
      </div>
      <ol class="timeline">
        {
          experience.map((entry, index) => (
            <li class="timeline-item">
              <span class:list={['timeline-dot', index % 2 === 0 ? 'timeline-dot--primary' : 'timeline-dot--secondary']} aria-hidden="true" />
              <div class:list={['timeline-card', index % 2 === 0 ? 'timeline-card--primary' : 'timeline-card--secondary']}>
                <Heading level="h4" size="h5">
                  {entry.title}
                </Heading>
                <p class="timeline-meta">
                  {entry.organization}{entry.location && ` | ${entry.location}`}
                </p>
                <p class="timeline-period">{entry.period}</p>
                {entry.description && <p class="mt-2">{entry.description}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="mt-16">
      <div class="mb-6 flex items-center gap-3">
        <Icon aria-hidden="true" name="lucide:graduation-cap" size="1.75rem" />
        <Heading level="h3" size="h4">Education</Heading>
      </div>
      <ol class="timeline">
        {
          education.map((entry, index) => (
            <li class="timeline-item">
              <span class:list={['timeline-dot', index % 2 === 0 ? 'timeline-dot--primary' : 'timeline-dot--secondary']} aria-hidden="true" />
              <div class:list={['timeline-card', index % 2 === 0 ? 'timeline-card--primary' : 'timeline-card--secondary']}>
                <Heading level="h4" size="h5">
                  {entry.degree}
                </Heading>
                <p class="timeline-meta">
                  {entry.institution}{entry.location && ` | ${entry.location}`}
                </p>
                <p class="timeline-period">{entry.period}</p>
                {entry.description && <p class="mt-2">{entry.description}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="mt-16 grid grid-cols-1 gap-16 lg:grid-cols-2">
      <div>
        <div class="mb-6 flex items-center gap-3">
          <Icon aria-hidden="true" name="lucide:sparkles" size="1.75rem" />
          <Heading level="h3" size="h4">Skills</Heading>
        </div>
        <div class="space-content">
          {
            skills.map((group) => (
              <div>
                <Heading level="h4" size="h6" class="mb-2">
                  {group.category}
                </Heading>
                <ul class="skill-list">
                  {group.skills.map((skill) => (
                    <li class="skill-pill">{skill}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <div class="mb-6 flex items-center gap-3">
          <Icon aria-hidden="true" name="lucide:users" size="1.75rem" />
          <Heading level="h3" size="h4">Leadership</Heading>
        </div>
        <ul class="leadership-list">
          {
            leadership.map((entry) => (
              <li class="leadership-item">
                <p class="leadership-org">{entry.organization}</p>
                <p class="leadership-roles">{entry.roles.join(', ')}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;

    &::before {
      position: absolute;
      inset-inline-start: 5px;
      inset-block: 0.4rem;
      inline-size: 2px;
      background-image: linear-gradient(to bottom, var(--color-primary-400), var(--color-secondary-400));
      content: '';
    }
  }

  .timeline-item {
    position: relative;
    padding-inline-start: var(--space-l);
  }

  .timeline-dot {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: var(--space-m);
    inline-size: 12px;
    block-size: 12px;
    border-radius: 999px;
    box-shadow:
      0 0 0 4px var(--background-color),
      0 0 9px 1px var(--dot-glow);
  }

  .timeline-dot--primary {
    --dot-glow: color-mix(in oklch, var(--color-primary-400) 55%, transparent);
    background-color: var(--color-primary-400);
  }

  .timeline-dot--secondary {
    --dot-glow: color-mix(in oklch, var(--color-secondary-400) 55%, transparent);
    background-color: var(--color-secondary-400);
  }

  .timeline-card {
    padding: var(--space-m) var(--space-l);
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-l);
  }

  .timeline-card--primary {
    border-inline-start: 4px solid var(--color-primary-400);
    background-color: color-mix(in oklch, var(--color-primary-400) 8%, var(--background-color));
  }

  .timeline-card--secondary {
    border-inline-start: 4px solid var(--color-secondary-400);
    background-color: color-mix(in oklch, var(--color-secondary-400) 8%, var(--background-color));
  }

  .timeline-meta {
    color: var(--foreground-color);
    font-weight: 600;
  }

  .timeline-period {
    color: var(--color-neutral-700);
    font-size: var(--font-size--1);
  }

  :global(.darkmode) .timeline-period {
    color: var(--color-neutral-500);
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-pill {
    border: 2px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    padding: var(--space-4xs) var(--space-xs);
    font-weight: 600;
    font-size: var(--font-size--1);
  }

  .leadership-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leadership-org {
    margin: 0;
    font-weight: 600;
  }

  .leadership-roles {
    margin: 0;
    color: var(--color-neutral-700);
    font-size: var(--font-size--1);
  }

  :global(.darkmode) .leadership-roles {
    color: var(--color-neutral-500);
  }
</style>
