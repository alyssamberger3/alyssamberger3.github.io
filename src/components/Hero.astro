---
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { experience } from '@utils/resumeData'

/**
 * Hero Component
 *
 * @description A component that displays a hero section with a title, description, and a
 * snapshot of the current resume entry linking through to the full resume
 */
const [currentRole] = experience
---

<section class="hero my-32 md:my-48">
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-24 lg:grid-cols-2">
      <div class="flex flex-col items-center gap-10 md:items-start">
        <div class="hero-intro">
          <img
            class="hero-portrait"
            src="/images/alyssa-berger.gif"
            alt="Portrait of Alyssa Berger"
            width="220"
            height="220"
          />
          <h1 class="text-center text-6xl md:text-left lg:text-7xl">
            <slot><span class="text-gradient">Hello!</span> I'm Alyssa Berger</slot>
          </h1>
        </div>
        <p class="hero-blurb text-center text-2xl md:text-left">
          I'm a UX Design student at Purdue University ('27) and a Section 508 Trusted Tester. My work is grounded in
          accessibility, and I'm especially curious about where it intersects with artificial intelligence.
        </p>
        <div class="flex flex-col gap-3 min-[500px]:flex-row">
          <Link href="/#projects" isButton type="primary" animateOnHover animationType="boop">
            <Icon aria-hidden="true" name="lucide:folder-open" size="1.5rem" />
            View my work
          </Link>
        </div>
      </div>
      <div class="resume-snapshot">
        <p class="resume-snapshot-eyebrow">
          <Icon aria-hidden="true" name="lucide:briefcase" size="1.25rem" />
          Currently
        </p>
        <Heading level="h2" size="h5" class="mb-2">{currentRole.title}</Heading>
        <p class="resume-snapshot-org">
          {currentRole.organization}
          {currentRole.location && `, ${currentRole.location}`}
        </p>
        {currentRole.description && <p class="mt-4">{currentRole.description}</p>}
        <Link href="#resume" isButton type="secondary" animateOnHover animationType="nudge" class="mt-6">
          View full resume
          <Icon aria-hidden="true" name="lucide:arrow-down" size="1.5rem" />
        </Link>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  h1 {
    text-wrap: unset;
  }

  .hero-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .hero-portrait {
    flex-shrink: 0;
    border: 2px solid var(--border-color-subtle);
    border-radius: 50%;
    inline-size: 220px;
    block-size: 220px;
    object-fit: cover;
  }

  .hero-blurb {
    color: var(--foreground-color);
    max-inline-size: 55ch;
  }

  @media (min-width: 768px) {
    .hero-intro {
      flex-direction: row;
      text-align: start;
    }
  }

  .text-gradient {
    background: linear-gradient(
      315deg,
      light-dark(var(--color-primary-300), var(--color-secondary-100)) 25%,
      light-dark(var(--color-secondary-300), var(--color-primary-200))
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .resume-snapshot {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--border-color-subtle);
    border-radius: var(--radius-l);
    background-color: light-dark(var(--color-neutral-200), var(--color-neutral-800));
    padding: var(--space-xl);
    inline-size: 100%;
  }

  .resume-snapshot-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    color: var(--link-color);
    font-weight: 600;
    font-size: var(--font-size--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .resume-snapshot-org {
    color: var(--foreground-color);
    font-weight: 600;
  }

  .resume-snapshot :global(.button) {
    align-self: flex-start;
  }
</style>
