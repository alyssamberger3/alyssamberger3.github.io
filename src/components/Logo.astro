---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'

/**
 * Logo Component
 *
 * @description The site wordmark: Alyssa's name set in the site's own type, with a small
 * blinking text-cursor accent as a nod to her work designing interfaces
 */
---

<Link href="/" class="logo-mark">
  <span class="logo-name">{themeConfig.name}</span>
  <span class="logo-cursor" aria-hidden="true"></span>
</Link>

<style lang="scss">
  .logo-mark {
    --border-width: 2px;

    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    border: none;
    border-radius: var(--radius-m);
    background: linear-gradient(115deg, #a767e5, #12bcfe, #44ce7b, #fad648, #a767e5);
    background-position: 0 0;
    background-size: 200% 100%;
    padding: var(--space-2xs);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;

    &::before {
      position: absolute;
      z-index: 1;
      inset: var(--border-width);
      border-radius: calc(var(--radius-m) - var(--border-width));
      background-color: var(--background-color);
      content: '';
    }

    & > * {
      position: relative;
      z-index: 2;
    }

    @media (min-width: 768px) {
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-mark:where(:hover, :focus-visible) {
      animation: logo-rainbow 1s linear infinite;
    }
  }

  @keyframes logo-rainbow {
    to {
      background-position: 200% 0;
    }
  }

  .logo-cursor {
    display: inline-block;
    inline-size: 0.125em;
    block-size: 0.85em;
    border-radius: 999px;
    background-color: var(--link-color);
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-cursor {
      animation: logo-cursor-blink 1.1s steps(1, end) infinite;
    }
  }

  @keyframes logo-cursor-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
